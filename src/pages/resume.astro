---

<Layout
  title="Resume — Frank Niu"
  description="Frank Niu's résumé — roles, organizations, and results."
>
  <section class="rp" id="resume" aria-labelledby="rp-heading">
    <div class="container">
      <header class="rp__head" data-reveal>
        <p class="label">§ Resume — roles &amp; results</p>
        <h1 class="display rp__title" id="rp-heading">Frank Niu</h1>
        <p class="rp__contact mono">267-428-9462| Frank.z.niu@gmail.com| Houston, Texas (77082)</p>
      </header>

      <p class="label rp__section" data-reveal>Experience</p>

      <ol class="rp__list">
        {
          experience.map((r) => (
            <li class="rp__row" data-reveal>
              <span class="mono rp__idx">[{r.idx}]</span>
              <div class="rp__role">
                <div class="rp__role-head">
                  <h2 class="rp__role-name">{r.role}</h2>
                  <span class="rp__dates mono">{r.dates}</span>
                </div>
                <p class="rp__org">{r.org}</p>
                <ul class="rp__bullets">
                  {r.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <Footer />
</Layout>

<style>
  .rp {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(2rem, 1rem + 3vw, 4rem);
  }
  .rp__head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-bottom: clamp(2rem, 1rem + 3vw, 3.5rem);
  }
  .rp__title {
    font-size: var(--fs-display);
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .rp__contact {
    color: var(--ink-dim);
    font-size: var(--fs-small);
  }
  .rp__section {
    margin-bottom: var(--sp-2);
  }

  .rp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .rp__row {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: clamp(1.25rem, 0.9rem + 1vw, 1.75rem) 0.5rem;
    border-bottom: 1px solid var(--line);
    transition: padding-left var(--dur) var(--ease-out);
  }
  .rp__row:hover {
    padding-left: 1.25rem;
  }
  .rp__idx {
    color: var(--ink-faint);
    font-size: var(--fs-small);
    transition: color var(--dur) var(--ease-out);
  }
  .rp__row:hover .rp__idx {
    color: var(--accent);
  }
  .rp__role-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }
  .rp__role-name {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .rp__dates {
    font-size: var(--fs-micro);
    color: var(--ink-faint);
    white-space: nowrap;
  }
  .rp__org {
    color: var(--accent);
    font-size: var(--fs-small);
    font-weight: 500;
    margin-top: 0.2rem;
  }
  .rp__bullets {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .rp__bullets li {
    color: var(--ink-dim);
    font-size: var(--fs-small);
    max-width: 62ch;
  }

  @media (max-width: 560px) {
    .rp__row {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 1rem;
    }
    .rp__row:hover {
      padding-left: 0.5rem;
    }
  }
</style>
